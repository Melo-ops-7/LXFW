# 复制为 .env 后填写。密钥仅保存在后端，不会返回给前端。

# Dify 工具调用鉴权 Key（与 Dify HTTP 节点请求头 X-API-Key 一致）
TOOL_API_KEY=xinxifang-tool-key-2026

# Dify 地址（Docker 部署默认 http://localhost/v1；按实际修改）
DIFY_BASE_URL=http://localhost/v1

# 三个 Agent 应用的 API Key（Dify 应用 → 访问 API → API 服务器 → 生成密钥）
DIFY_STUDENT_API_KEY=
DIFY_EMPLOYEE_API_KEY=
DIFY_SERVICE_API_KEY=